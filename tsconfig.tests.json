{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "build/tests",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    "src/features/auth/application/**/*.ts",
    "src/features/auth/infrastructure/**/*.ts",
    "src/features/auth/server/config.ts",
    "src/features/auth/server/oauth-config.ts",
    "src/features/auth/domain/**/*.ts",
    "src/features/groups/application/**/*.ts",
    "src/features/groups/infrastructure/**/*.ts",
    "src/features/groups/domain/**/*.ts",
    "src/features/matchdays/application/**/*.ts",
    "src/features/matchdays/infrastructure/**/*.ts",
    "src/features/matchdays/domain/**/*.ts",
    "src/features/results/application/**/*.ts",
    "src/features/results/infrastructure/**/*.ts",
    "src/features/results/domain/**/*.ts",
    "src/features/jornadas/domain/**/*.ts",
    "src/features/porras/domain/**/*.ts",
    "src/features/porras/application/**/*.ts",
    "src/features/porras/infrastructure/**/*.ts",
    "src/lib/format-money.ts",
    "src/features/profile/application/**/*.ts",
    "src/features/profile/infrastructure/**/*.ts",
    "src/features/profile/domain/**/*.ts",
    "src/lib/http/**/*.ts",
    "src/lib/route-id.ts",
    "src/lib/format-date.ts",
    "src/lib/live-refresh.ts",
    "src/lib/cn.ts",
    "src/lib/ui-text.ts",
    "src/lib/format-number.ts",
    "src/lib/motion.ts",
    "src/features/superadmin/domain/**/*.ts",
    "src/features/superadmin/application/**/*.ts",
    "src/features/superadmin/infrastructure/**/*.ts"
  ]
}